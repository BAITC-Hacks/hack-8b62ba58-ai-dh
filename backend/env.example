HOST=127.0.0.1
PORT=4000
DATABASE_PATH=./data/ai-sana.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
SEED_DATA=true

# Set a real key only in backend/.env. With a key the server selects OpenAI automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: AI_PROVIDER=demo forces the local demo without API calls.
