{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "AI Sana: сайт + API",
      "program": "${workspaceFolder}/backend/src/server.ts",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": ["--env-file-if-exists=backend/.env"],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "(http://(?:127\\.0\\.0\\.1|localhost):[0-9]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
